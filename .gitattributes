* text=auto

# Unity YAML files merge better as text with LF endings
*.cs text eol=lf diff=csharp
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
